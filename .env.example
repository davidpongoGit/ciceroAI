# Local development only. Replace every CHANGE_ME value; never commit .env.
HOST=127.0.0.1
PORT=3000
POSTGRES_USER=cai_local
POSTGRES_DB=cai_local
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
# Use the same password as above; URL-encode reserved characters in this URL.
DATABASE_URL=postgresql://cai_local:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/cai_local
# M1 workflow is disabled until explicit identity and independent secrets are set.
WORKFLOW_ENABLED=false
ORGANISATION_ID=CHANGE_ME_UUID
REPOSITORY_ID=CHANGE_ME_NUMERIC_REPOSITORY_ID
INSTALLATION_ID=CHANGE_ME_NUMERIC_INSTALLATION_ID
WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
API_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Enable only for the configured personal installation operator to manage approvals.
PLAN_APPROVALS_ENABLED=false
# Explicitly enable only for this personal installation's scoped maintenance worker.
MAINTENANCE_ENABLED=false
RESTORE_ENABLED=false

# Publishing is opt-in and uses a separate automation-only installation token.
# These placeholders enable nothing; exact destination/base/path also bind the plan.
PUBLISH_ENABLED=false
APPLICATION_REPOSITORY=CHANGE_ME_OWNER/APPLICATION_REPO
AUTOMATION_REPOSITORY_ID=CHANGE_ME_NUMERIC_AUTOMATION_REPO_ID
AUTOMATION_REPOSITORY=CHANGE_ME_OWNER/PLAYWRIGHT_REPO
AUTOMATION_BASE_BRANCH=main
AUTOMATION_INSTALLATION_TOKEN=CHANGE_ME_AUTOMATION_ONLY_TOKEN
