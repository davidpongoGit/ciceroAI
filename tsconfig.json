{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@cai/contracts": ["./packages/contracts/src/index.ts"],
      "@cai/database": ["./packages/database/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "vitest*.ts"
  ],
  "exclude": ["**/dist/**", "node_modules"]
}
